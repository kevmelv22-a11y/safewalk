{
  "name": "safewalk",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "convex": "^1.48.0",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.15",
    "expo-battery": "~58.0.4",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-contacts": "~58.0.10",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-quick-actions": "~6.0.2",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.5",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.3",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "i18next": "^27.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-purchases": "^10.16.0",
    "react-native-quick-settings-tile": "^0.1.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "safewalk-native": "file:modules/safewalk-native",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "ajv": "^8.20.0",
    "convex-test": "^0.0.66",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "convex:dev": "convex dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex && tsc --noEmit -p admin",
    "test": "jest",
    "test:convex": "vitest run",
    "test:all": "npm run typecheck && jest && vitest run",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "lint": "eslint ."
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "testPathIgnorePatterns": [
      "/admin/",
      "/node_modules/",
      "/convex/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/plugins/asyncStorageMock.js"
    ]
  }
}
