{
  "expo": {
    "name": "SafeWalk",
    "slug": "safewalk",
    "scheme": "safewalk",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "nl.safewalk.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SafeWalk gebruikt je locatie om je reis te delen met contacten die jij kiest, om een bestemming op de kaart te tonen en om je laatst bekende locatie mee te sturen bij SOS.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tijdens een reis die jij zelf start, deelt SafeWalk je locatie ook als de app op de achtergrond staat of je scherm uit is, zodat je gekozen contacten kunnen meekijken. Delen stopt zodra je de reis beëindigt.",
        "NSLocationAlwaysUsageDescription": "Tijdens een reis die jij zelf start, deelt SafeWalk je locatie ook op de achtergrond. Delen stopt zodra je de reis beëindigt.",
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "audio"
        ],
        "CFBundleDevelopmentRegion": "nl",
        "CFBundleLocalizations": [
          "nl",
          "en"
        ]
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nl.safewalk.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.FLASHLIGHT",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#040B1A"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationWhenInUsePermission": "SafeWalk gebruikt je locatie om je reis te delen met contacten die jij kiest, om een bestemming op de kaart te tonen en om je laatst bekende locatie mee te sturen bij SOS."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7856FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#040B1A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#040B1A"
          },
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "SafeWalk gebruikt de camera alleen voor de zaklamp (torch) tijdens een gevaar-alarm dat jij start.",
          "microphonePermission": "SafeWalk neemt geluid op als jij \"Ik voel me niet veilig\" activeert, zodat vertrouwde contacten de opname kunnen beluisteren.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true,
          "microphonePermission": "SafeWalk neemt geluid op als jij \"Ik voel me niet veilig\" activeert. Alleen als jij dat apart aanzet, loopt de opname door op de achtergrond of bij vergrendeld scherm (met zichtbare melding). Opname stopt wanneer jij hem beëindigt."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "SafeWalk toont je telefooncontacten zodat jij er kunt aanvinken wie een melding mag krijgen. We bewaren alleen wat jij selecteert."
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "quick_ping",
              "title": "Stuur live locatie",
              "subtitle": "Deel nu met vertrouwde contacten",
              "icon": "symbol:location.fill",
              "params": {
                "href": "/quick-ping"
              }
            },
            {
              "id": "open_dashboard",
              "title": "Open SafeWalk",
              "subtitle": "Hoofdscherm",
              "icon": "symbol:shield.fill",
              "params": {
                "href": "/dashboard"
              }
            }
          ]
        }
      ],
      [
        "react-native-quick-settings-tile",
        {
          "label": "SafeWalk locatie",
          "url": "safewalk://quick-ping",
          "android": {
            "icon": "./assets/native/qs_location.xml",
            "requireUnlock": true,
            "appendTimestamp": true
          },
          "ios": {
            "systemImage": "location.fill"
          }
        }
      ],
      [
        "./modules/safewalk-native/plugin/withSafewalkNative.js",
        {}
      ],
      "./plugins/withAndroidReleaseKeep.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "5732aaf2-dc13-4931-a862-520ff6c147d7"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "safewalk": {
        "quickPingPath": "/quick-ping",
        "deepLinks": {
          "quickPing": "safewalk://quick-ping"
        },
        "nativeStatus": {
          "volumeDoublePress": "android-foreground-only-uncompiled-until-dev-client",
          "qsTile": "source-configured-requires-dev-build",
          "iosQuickActions": "source-configured-requires-dev-build",
          "backgroundTorch": "not-supported",
          "backgroundAlarmAudio": "attempt-via-expo-audio-background-playback-untested-native",
          "backgroundRecording": "explicit-opt-in-runtime-untested-native"
        }
      }
    },
    "description": "SafeWalk – Samen veilig thuis. Deel je reis tijdelijk met vertrouwde contacten.",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "kevke-026s-team"
  }
}
