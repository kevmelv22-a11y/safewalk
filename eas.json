{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_iKwOnTWFKCnvNmkwxcBBtcKGnJE",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_oguASbDRCUUMdrgHkcuGSmTVmRy"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_iKwOnTWFKCnvNmkwxcBBtcKGnJE",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_oguASbDRCUUMdrgHkcuGSmTVmRy"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_iKwOnTWFKCnvNmkwxcBBtcKGnJE",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_oguASbDRCUUMdrgHkcuGSmTVmRy"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "adhoc": {
      "distribution": "internal",
      "credentialsSource": "local",
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "env": {
        "SAFEWALK_IOS_ADHOC": "1",
        "APP_VARIANT": "adhoc",
        "EXPO_PUBLIC_CONVEX_URL": "https://agile-capybara-401.convex.cloud",
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_iKwOnTWFKCnvNmkwxcBBtcKGnJE",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_KEY": "goog_oguASbDRCUUMdrgHkcuGSmTVmRy"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "<APP_STORE_CONNECT_APP_ID>"
      },
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./google-play-service-account.json"
      }
    }
  }
}
