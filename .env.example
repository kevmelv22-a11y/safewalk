# Client (publiek – de anon key is bedoeld voor de app; RLS beschermt de data)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
GOOGLE_MAPS_ANDROID_API_KEY=<google-maps-key>

# Edge Function secrets – NIET in de app; zet via: supabase secrets set ...
# SUPABASE_SERVICE_ROLE_KEY wordt automatisch door Supabase gezet
CRON_SECRET=<lange-willekeurige-string>
EXPO_ACCESS_TOKEN=<optioneel: Expo push security token>
