# Client (publiek). Wordt door `npx convex dev` automatisch in .env.local gezet.
EXPO_PUBLIC_CONVEX_URL=https://<deployment-naam>.convex.cloud
GOOGLE_MAPS_ANDROID_API_KEY=<google-maps-key>

# Server-secrets – NIET in de app. Zet in de Convex-deployment:
#   npx convex env set EXPO_ACCESS_TOKEN <optioneel: Expo push security token>
#   npx @convex-dev/auth   (zet JWT_PRIVATE_KEY, JWKS en SITE_URL voor Convex Auth)
